{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panelinha-lobby",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "REGISTRY", "class_name": "RoomRegistry"},
      {"name": "ROOMS", "class_name": "LobbyRoom"}
    ]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RoomRegistry", "LobbyRoom"]}],
  "vars": {
    "ALLOWED_ORIGINS": "https://localhost,http://127.0.0.1:8000,http://localhost:8000"
  },
  "observability": {"enabled": false}
}
