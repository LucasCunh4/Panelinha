{
  "name": "panelinha-multiplayer-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:manual": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "wrangler": "4.158.0",
    "ws": "8.21.0"
  }
}
